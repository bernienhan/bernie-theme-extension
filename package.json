{
  "name": "bernie-theme",
  "displayName": "Bernie Themes",
  "description": "A collection of clean, modern, high-contrast dark and custom themes by Bernie.",
  "version": "0.0.1",
  "type": "module",
  "publisher": "bernie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bernie/bernie-theme"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "color-theme",
    "bernie",
    "modern",
    "minimalist"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bernieTheme.openWarmthSlider",
        "title": "Bernie: Open Warmth Slider (Draggable UI)",
        "category": "Bernie Theme"
      },
      {
        "command": "bernieTheme.resetWarmth",
        "title": "Bernie: Reset Warmth to Default",
        "category": "Bernie Theme"
      }
    ],
    "configuration": {
      "title": "Bernie Theme",
      "properties": {
        "bernieTheme.lightWarmth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 30,
          "description": "Warmth level (color temperature) for Bernie Light Theme (0 = Cool Ice, 100 = Sepia Solarized)."
        }
      }
    },
    "themes": [
      {
        "label": "Bernie Dark (Eye Care)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-dark.json"
      },
      {
        "label": "Bernie Velvet (Soft Pastel)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-velvet.json"
      },
      {
        "label": "Bernie Rose (Sakura Blossom)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-rose.json"
      },
      {
        "label": "Bernie Midnight (OLED Gold)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-midnight.json"
      },
      {
        "label": "Bernie Light (Paper Clean)",
        "uiTheme": "vs",
        "path": "./themes/bernie-light.json"
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node",
    "build": "npm run compile && tsx src/build.ts",
    "package": "npm run compile && vsce package --allow-missing-repository --no-dependencies",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "colord": "^2.9.3",
    "esbuild": "^0.20.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
