{
  "name": "bernie-theme",
  "displayName": "Bernie Themes",
  "description": "A collection of clean, modern, high-contrast dark and custom themes by Bernie.",
  "version": "0.0.1",
  "type": "module",
  "publisher": "bernie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bernie/bernie-theme"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "color-theme",
    "bernie",
    "modern",
    "minimalist"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Bernie Dark (Eye Care)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-dark.json"
      },
      {
        "label": "Bernie Velvet (Soft Pastel)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-velvet.json"
      },
      {
        "label": "Bernie Rose (Sakura Blossom)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-rose.json"
      },
      {
        "label": "Bernie Midnight (OLED Gold)",
        "uiTheme": "vs-dark",
        "path": "./themes/bernie-midnight.json"
      },
      {
        "label": "Bernie Light (Paper Clean)",
        "uiTheme": "vs",
        "path": "./themes/bernie-light.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "package": "vsce package --allow-missing-repository --no-dependencies",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vscode/vsce": "^2.24.0",
    "colord": "^2.9.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
