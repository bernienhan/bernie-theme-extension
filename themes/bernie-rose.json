{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bernie Rose (Sakura Blossom)",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#fce7f3",
    "variable.readonly": "#fce7f3",
    "variable.defaultLibrary": "#e879f9",
    "parameter": "#fbcfe8",
    "function": "#f472b6",
    "function.defaultLibrary": "#f472b6",
    "member": "#f472b6",
    "method": "#f472b6",
    "property": "#fda4af",
    "property.readonly": "#fda4af",
    "property.defaultLibrary": "#fda4af",
    "class": "#e879f9",
    "interface": "#e879f9",
    "enum": "#e879f9",
    "enumMember": "#f472b6",
    "type": "#e879f9",
    "type.defaultLibrary": "#e879f9",
    "typeParameter": "#e879f9",
    "keyword": "#fb7185",
    "comment": {
      "foreground": "#836577",
      "fontStyle": "italic",
      "italic": true
    },
    "string": "#fef08a",
    "number": "#f472b6",
    "regexp": "#f43f5e",
    "operator": "#fce7f3",
    "namespace": "#e879f9",
    "macro": "#e879f9",
    "selfKeyword": {
      "foreground": "#e879f9",
      "italic": true
    },
    "builtinType": "#e879f9",
    "magicFunction": "#f472b6"
  },
  "colors": {
    "focusBorder": "#f472b6",
    "foreground": "#fce7f3",
    "disabledForeground": "#7a5a6c",
    "selection.background": "#ec489938",
    "descriptionForeground": "#d4a5b8",
    "errorForeground": "#fb7185",
    "icon.foreground": "#d4a5b8",
    "titleBar.activeBackground": "#140f17",
    "titleBar.activeForeground": "#fce7f3",
    "titleBar.inactiveBackground": "#140f17",
    "titleBar.inactiveForeground": "#7a5a6c",
    "titleBar.border": "#2d1f33",
    "activityBar.background": "#140f17",
    "activityBar.foreground": "#f472b6",
    "activityBar.inactiveForeground": "#7a5a6c",
    "activityBar.border": "#2d1f33",
    "activityBarBadge.background": "#f472b6",
    "activityBarBadge.foreground": "#140f17",
    "sideBar.background": "#140f17",
    "sideBar.foreground": "#d4a5b8",
    "sideBar.border": "#2d1f33",
    "sideBarTitle.foreground": "#fce7f3",
    "sideBarSectionHeader.background": "#140f17",
    "sideBarSectionHeader.foreground": "#fce7f3",
    "sideBarSectionHeader.border": "#2d1f33",
    "list.activeSelectionBackground": "#33233b",
    "list.activeSelectionForeground": "#fce7f3",
    "list.inactiveSelectionBackground": "#33233b99",
    "list.inactiveSelectionForeground": "#fce7f3",
    "list.hoverBackground": "#261b2c",
    "list.hoverForeground": "#fce7f3",
    "list.focusBackground": "#33233b",
    "list.focusForeground": "#fce7f3",
    "list.highlightForeground": "#f472b6",
    "list.dropBackground": "#f472b633",
    "editorGroup.border": "#2d1f33",
    "editorGroupHeader.tabsBackground": "#140f17",
    "editorGroupHeader.noTabsBackground": "#1a141d",
    "tab.activeBackground": "#1a141d",
    "tab.activeForeground": "#fce7f3",
    "tab.activeBorder": "#1a141d",
    "tab.activeBorderTop": "#f472b6",
    "tab.inactiveBackground": "#140f17",
    "tab.inactiveForeground": "#7a5a6c",
    "tab.border": "#2d1f33",
    "tab.hoverBackground": "#1a141d",
    "tab.hoverForeground": "#fce7f3",
    "tab.unfocusedActiveBorderTop": "#f472b680",
    "editor.background": "#1a141d",
    "editor.foreground": "#fce7f3",
    "editorLineNumber.foreground": "#7a5a6c",
    "editorLineNumber.activeForeground": "#f472b6",
    "editorCursor.foreground": "#f472b6",
    "editor.selectionBackground": "#ec489938",
    "editor.selectionHighlightBackground": "#ec489999",
    "editor.wordHighlightBackground": "#f472b626",
    "editor.wordHighlightStrongBackground": "#f472b640",
    "editor.findMatchBackground": "#f472b650",
    "editor.findMatchHighlightBackground": "#f472b680",
    "editor.lineHighlightBackground": "#231b27",
    "editor.lineHighlightBorder": "#231b2700",
    "editorWhitespace.foreground": "#7a5a6c4d",
    "editorIndentGuide.background1": "#2d1f3399",
    "editorIndentGuide.activeBackground1": "#f472b6",
    "editorRuler.foreground": "#2d1f33",
    "editorCodeLens.foreground": "#7a5a6c",
    "editorBracketMatch.background": "#f472b633",
    "editorBracketMatch.border": "#f472b6",
    "editorOverviewRuler.border": "#2d1f3300",
    "editorOverviewRuler.findMatchForeground": "#f472b650",
    "editorOverviewRuler.errorForeground": "#fb7185",
    "editorOverviewRuler.warningForeground": "#fbb6ce",
    "editorOverviewRuler.infoForeground": "#f472b6",
    "editorWidget.background": "#201825",
    "editorWidget.foreground": "#fce7f3",
    "editorWidget.border": "#f472b6",
    "editorHoverWidget.background": "#201825",
    "editorHoverWidget.border": "#2d1f33",
    "editorSuggestWidget.background": "#201825",
    "editorSuggestWidget.border": "#2d1f33",
    "editorSuggestWidget.foreground": "#fce7f3",
    "editorSuggestWidget.highlightForeground": "#f472b6",
    "editorSuggestWidget.selectedBackground": "#33233b",
    "statusBar.background": "#140f17",
    "statusBar.foreground": "#d4a5b8",
    "statusBar.border": "#2d1f33",
    "statusBar.debuggingBackground": "#fb7185",
    "statusBar.debuggingForeground": "#140f17",
    "statusBar.noFolderBackground": "#140f17",
    "statusBarItem.hoverBackground": "#261b2c",
    "statusBarItem.activeBackground": "#33233b",
    "statusBarItem.prominentBackground": "#f472b6",
    "statusBarItem.prominentForeground": "#140f17",
    "panel.background": "#140f17",
    "panel.border": "#2d1f33",
    "panelTitle.activeForeground": "#fce7f3",
    "panelTitle.activeBorder": "#f472b6",
    "panelTitle.inactiveForeground": "#7a5a6c",
    "terminal.background": "#140f17",
    "terminal.foreground": "#fce7f3",
    "terminal.ansiBlack": "#1a141d",
    "terminal.ansiRed": "#fb7185",
    "terminal.ansiGreen": "#fda4af",
    "terminal.ansiYellow": "#fbb6ce",
    "terminal.ansiBlue": "#f472b6",
    "terminal.ansiMagenta": "#fb7185",
    "terminal.ansiCyan": "#e879f9",
    "terminal.ansiWhite": "#fce7f3",
    "terminal.ansiBrightBlack": "#7a5a6c",
    "terminal.ansiBrightRed": "#fb7185",
    "terminal.ansiBrightGreen": "#fda4af",
    "terminal.ansiBrightYellow": "#fbb6ce",
    "terminal.ansiBrightBlue": "#f472b6",
    "terminal.ansiBrightMagenta": "#fb7185",
    "terminal.ansiBrightCyan": "#e879f9",
    "terminal.ansiBrightWhite": "#ffffff",
    "button.background": "#f472b6",
    "button.foreground": "#140f17",
    "button.hoverBackground": "#f472b6d9",
    "button.secondaryBackground": "#261b2c",
    "button.secondaryForeground": "#fce7f3",
    "button.secondaryHoverBackground": "#33233b",
    "input.background": "#1a141d",
    "input.foreground": "#fce7f3",
    "input.border": "#2d1f33",
    "input.placeholderForeground": "#7a5a6c",
    "inputOption.activeBorder": "#f472b6",
    "inputValidation.errorBackground": "#fb718533",
    "inputValidation.errorBorder": "#fb7185",
    "inputValidation.warningBackground": "#fbb6ce33",
    "inputValidation.warningBorder": "#fbb6ce",
    "inputValidation.infoBackground": "#f472b633",
    "inputValidation.infoBorder": "#f472b6",
    "dropdown.background": "#1a141d",
    "dropdown.foreground": "#fce7f3",
    "dropdown.border": "#2d1f33",
    "breadcrumb.foreground": "#7a5a6c",
    "breadcrumb.focusForeground": "#fce7f3",
    "breadcrumb.activeSelectionForeground": "#f472b6",
    "breadcrumb.background": "#1a141d",
    "gitDecoration.addedResourceForeground": "#fda4af",
    "gitDecoration.modifiedResourceForeground": "#f472b6",
    "gitDecoration.deletedResourceForeground": "#fb7185",
    "gitDecoration.untrackedResourceForeground": "#e879f9",
    "gitDecoration.ignoredResourceForeground": "#614656",
    "gitDecoration.conflictingResourceForeground": "#fb7185",
    "gitDecoration.submoduleResourceForeground": "#7a5a6c",
    "badge.background": "#f472b6",
    "badge.foreground": "#140f17",
    "scrollbar.shadow": "#00000033",
    "scrollbarSlider.background": "#7a5a6c33",
    "scrollbarSlider.hoverBackground": "#7a5a6c59",
    "scrollbarSlider.activeBackground": "#7a5a6c80",
    "notificationCenterHeader.background": "#201825",
    "notifications.background": "#201825",
    "notifications.border": "#2d1f33",
    "quickInput.background": "#201825",
    "quickInput.foreground": "#fce7f3",
    "pickerGroup.border": "#2d1f33",
    "pickerGroup.foreground": "#f472b6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#836577",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#fb7185"
      }
    },
    {
      "name": "Storage & Declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type",
        "storage.type.enum",
        "storage.type.struct",
        "storage.modifier",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#f43f5e"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.module",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#e879f9"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "support.function.macro",
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "parameters variable.function"
      ],
      "settings": {
        "foreground": "#fbcfe8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.declaration",
        "variable.other.local"
      ],
      "settings": {
        "foreground": "#fce7f3"
      }
    },
    {
      "name": "Properties & Fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.field",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#fda4af"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#fef08a"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "meta.tag.sgml",
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#fb7185"
      }
    },
    {
      "name": "Tag Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#fbcfe8"
      }
    },
    {
      "name": "CSS Properties & Classes",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#fda4af"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css",
        "constant.other.color.rgb-value.hex.css"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.ternary",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#fce7f3"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.separator.key-value",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.bracket",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#d4a5b8"
      }
    },
    {
      "name": "Special Variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self",
        "variable.language.arguments"
      ],
      "settings": {
        "foreground": "#e879f9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#f43f5e"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#fb7185",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fbcfe8"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e879f9"
      }
    },
    {
      "name": "Markdown Code Block",
      "scope": [
        "markup.raw.inline.markdown",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#fef08a"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "JSON Property Names",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#fda4af"
      }
    }
  ]
}