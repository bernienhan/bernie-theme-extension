{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bernie Dark (Eye Care)",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#e6edf3",
    "variable.readonly": "#e6edf3",
    "variable.defaultLibrary": "#bc8cff",
    "parameter": "#ffa657",
    "function": "#79c0ff",
    "function.defaultLibrary": "#79c0ff",
    "member": "#79c0ff",
    "method": "#79c0ff",
    "property": "#79c0ff",
    "property.readonly": "#79c0ff",
    "property.defaultLibrary": "#79c0ff",
    "class": "#d2a8ff",
    "interface": "#d2a8ff",
    "enum": "#d2a8ff",
    "enumMember": "#f0883e",
    "type": "#d2a8ff",
    "type.defaultLibrary": "#d2a8ff",
    "typeParameter": "#d2a8ff",
    "keyword": "#ff7b72",
    "comment": {
      "foreground": "#6e7681",
      "fontStyle": "italic",
      "italic": true
    },
    "string": "#eed49f",
    "number": "#f0883e",
    "regexp": "#f47067",
    "operator": "#e6edf3",
    "namespace": "#d2a8ff",
    "macro": "#bc8cff",
    "selfKeyword": {
      "foreground": "#bc8cff",
      "italic": true
    },
    "builtinType": "#d2a8ff",
    "magicFunction": "#79c0ff"
  },
  "colors": {
    "focusBorder": "#58a6ff",
    "foreground": "#e6edf3",
    "disabledForeground": "#586069",
    "selection.background": "#1f385c80",
    "descriptionForeground": "#8b949e",
    "errorForeground": "#ff7b72",
    "icon.foreground": "#8b949e",
    "titleBar.activeBackground": "#090d12",
    "titleBar.activeForeground": "#e6edf3",
    "titleBar.inactiveBackground": "#090d12",
    "titleBar.inactiveForeground": "#586069",
    "titleBar.border": "#21262d",
    "activityBar.background": "#090d12",
    "activityBar.foreground": "#58a6ff",
    "activityBar.inactiveForeground": "#586069",
    "activityBar.border": "#21262d",
    "activityBarBadge.background": "#58a6ff",
    "activityBarBadge.foreground": "#090d12",
    "sideBar.background": "#090d12",
    "sideBar.foreground": "#8b949e",
    "sideBar.border": "#21262d",
    "sideBarTitle.foreground": "#e6edf3",
    "sideBarSectionHeader.background": "#090d12",
    "sideBarSectionHeader.foreground": "#e6edf3",
    "sideBarSectionHeader.border": "#21262d",
    "list.activeSelectionBackground": "#1c2636",
    "list.activeSelectionForeground": "#e6edf3",
    "list.inactiveSelectionBackground": "#1c263699",
    "list.inactiveSelectionForeground": "#e6edf3",
    "list.hoverBackground": "#161e29",
    "list.hoverForeground": "#e6edf3",
    "list.focusBackground": "#1c2636",
    "list.focusForeground": "#e6edf3",
    "list.highlightForeground": "#58a6ff",
    "list.dropBackground": "#58a6ff33",
    "editorGroup.border": "#21262d",
    "editorGroupHeader.tabsBackground": "#090d12",
    "editorGroupHeader.noTabsBackground": "#0d1117",
    "tab.activeBackground": "#0d1117",
    "tab.activeForeground": "#e6edf3",
    "tab.activeBorder": "#0d1117",
    "tab.activeBorderTop": "#58a6ff",
    "tab.inactiveBackground": "#090d12",
    "tab.inactiveForeground": "#586069",
    "tab.border": "#21262d",
    "tab.hoverBackground": "#0d1117",
    "tab.hoverForeground": "#e6edf3",
    "tab.unfocusedActiveBorderTop": "#58a6ff80",
    "editor.background": "#0d1117",
    "editor.foreground": "#e6edf3",
    "editorLineNumber.foreground": "#586069",
    "editorLineNumber.activeForeground": "#58a6ff",
    "editorCursor.foreground": "#58a6ff",
    "editor.selectionBackground": "#1f385c80",
    "editor.selectionHighlightBackground": "#1f385c99",
    "editor.wordHighlightBackground": "#58a6ff26",
    "editor.wordHighlightStrongBackground": "#58a6ff40",
    "editor.findMatchBackground": "#58a6ff38",
    "editor.findMatchHighlightBackground": "#58a6ff80",
    "editor.lineHighlightBackground": "#161f2c",
    "editor.lineHighlightBorder": "#161f2c00",
    "editorWhitespace.foreground": "#5860694d",
    "editorIndentGuide.background1": "#21262d99",
    "editorIndentGuide.activeBackground1": "#58a6ff",
    "editorRuler.foreground": "#21262d",
    "editorCodeLens.foreground": "#586069",
    "editorBracketMatch.background": "#58a6ff33",
    "editorBracketMatch.border": "#58a6ff",
    "editorOverviewRuler.border": "#21262d00",
    "editorOverviewRuler.findMatchForeground": "#58a6ff38",
    "editorOverviewRuler.errorForeground": "#ff7b72",
    "editorOverviewRuler.warningForeground": "#f0883e",
    "editorOverviewRuler.infoForeground": "#79c0ff",
    "editorWidget.background": "#131b26",
    "editorWidget.foreground": "#e6edf3",
    "editorWidget.border": "#58a6ff",
    "editorHoverWidget.background": "#131b26",
    "editorHoverWidget.border": "#21262d",
    "editorSuggestWidget.background": "#131b26",
    "editorSuggestWidget.border": "#21262d",
    "editorSuggestWidget.foreground": "#e6edf3",
    "editorSuggestWidget.highlightForeground": "#58a6ff",
    "editorSuggestWidget.selectedBackground": "#1c2636",
    "statusBar.background": "#090d12",
    "statusBar.foreground": "#8b949e",
    "statusBar.border": "#21262d",
    "statusBar.debuggingBackground": "#bc8cff",
    "statusBar.debuggingForeground": "#090d12",
    "statusBar.noFolderBackground": "#090d12",
    "statusBarItem.hoverBackground": "#161e29",
    "statusBarItem.activeBackground": "#1c2636",
    "statusBarItem.prominentBackground": "#58a6ff",
    "statusBarItem.prominentForeground": "#090d12",
    "panel.background": "#090d12",
    "panel.border": "#21262d",
    "panelTitle.activeForeground": "#e6edf3",
    "panelTitle.activeBorder": "#58a6ff",
    "panelTitle.inactiveForeground": "#586069",
    "terminal.background": "#090d12",
    "terminal.foreground": "#e6edf3",
    "terminal.ansiBlack": "#0d1117",
    "terminal.ansiRed": "#ff7b72",
    "terminal.ansiGreen": "#56d364",
    "terminal.ansiYellow": "#f0883e",
    "terminal.ansiBlue": "#79c0ff",
    "terminal.ansiMagenta": "#bc8cff",
    "terminal.ansiCyan": "#bc8cff",
    "terminal.ansiWhite": "#e6edf3",
    "terminal.ansiBrightBlack": "#586069",
    "terminal.ansiBrightRed": "#ff7b72",
    "terminal.ansiBrightGreen": "#56d364",
    "terminal.ansiBrightYellow": "#f0883e",
    "terminal.ansiBrightBlue": "#79c0ff",
    "terminal.ansiBrightMagenta": "#bc8cff",
    "terminal.ansiBrightCyan": "#bc8cff",
    "terminal.ansiBrightWhite": "#ffffff",
    "button.background": "#58a6ff",
    "button.foreground": "#090d12",
    "button.hoverBackground": "#58a6ffd9",
    "button.secondaryBackground": "#161e29",
    "button.secondaryForeground": "#e6edf3",
    "button.secondaryHoverBackground": "#1c2636",
    "input.background": "#0d1117",
    "input.foreground": "#e6edf3",
    "input.border": "#21262d",
    "input.placeholderForeground": "#586069",
    "inputOption.activeBorder": "#58a6ff",
    "inputValidation.errorBackground": "#ff7b7233",
    "inputValidation.errorBorder": "#ff7b72",
    "inputValidation.warningBackground": "#f0883e33",
    "inputValidation.warningBorder": "#f0883e",
    "inputValidation.infoBackground": "#79c0ff33",
    "inputValidation.infoBorder": "#79c0ff",
    "dropdown.background": "#0d1117",
    "dropdown.foreground": "#e6edf3",
    "dropdown.border": "#21262d",
    "breadcrumb.foreground": "#586069",
    "breadcrumb.focusForeground": "#e6edf3",
    "breadcrumb.activeSelectionForeground": "#58a6ff",
    "breadcrumb.background": "#0d1117",
    "gitDecoration.addedResourceForeground": "#56d364",
    "gitDecoration.modifiedResourceForeground": "#79c0ff",
    "gitDecoration.deletedResourceForeground": "#ff7b72",
    "gitDecoration.untrackedResourceForeground": "#d2a8ff",
    "gitDecoration.ignoredResourceForeground": "#484f58",
    "gitDecoration.conflictingResourceForeground": "#ff7b72",
    "gitDecoration.submoduleResourceForeground": "#586069",
    "badge.background": "#58a6ff",
    "badge.foreground": "#090d12",
    "scrollbar.shadow": "#00000033",
    "scrollbarSlider.background": "#58606933",
    "scrollbarSlider.hoverBackground": "#58606959",
    "scrollbarSlider.activeBackground": "#58606980",
    "notificationCenterHeader.background": "#131b26",
    "notifications.background": "#131b26",
    "notifications.border": "#21262d",
    "quickInput.background": "#131b26",
    "quickInput.foreground": "#e6edf3",
    "pickerGroup.border": "#21262d",
    "pickerGroup.foreground": "#58a6ff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6e7681",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Storage & Declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type",
        "storage.type.enum",
        "storage.type.struct",
        "storage.modifier",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.module",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "support.function.macro",
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "parameters variable.function"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.declaration",
        "variable.other.local"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Properties & Fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.field",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#eed49f"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "meta.tag.sgml",
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Tag Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "CSS Properties & Classes",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css",
        "constant.other.color.rgb-value.hex.css"
      ],
      "settings": {
        "foreground": "#f0883e"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.ternary",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.separator.key-value",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.bracket",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#8b949e"
      }
    },
    {
      "name": "Special Variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self",
        "variable.language.arguments"
      ],
      "settings": {
        "foreground": "#bc8cff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#f47067"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ff7b72",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bc8cff"
      }
    },
    {
      "name": "Markdown Code Block",
      "scope": [
        "markup.raw.inline.markdown",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#eed49f"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "JSON Property Names",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    }
  ]
}